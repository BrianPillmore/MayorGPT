# Provider-neutral settings for integrations/api/mayorgpt_llm.py.
# Copy to .env, fill in, and load with: set -a; source .env; set +a
# Never commit real keys.

# Provider preset: openai, gemini, xai, mistral, deepseek, groq, together, fireworks,
# perplexity, openrouter, cohere, qwen, azure, openai-compatible, ollama, lmstudio, vllm, llamacpp
MAYORGPT_PROVIDER=

# Model identifier exactly as your provider documents it. No default is built in.
MAYORGPT_MODEL=

# Optional override of the preset base URL. Required for azure and openai-compatible.
MAYORGPT_BASE_URL=

# API key. If empty, the provider's conventional variable below is used.
# Local servers (ollama, lmstudio, llamacpp) need no key.
MAYORGPT_API_KEY=

# Conventional per-provider variables (set only the one you use).
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# PERPLEXITY_API_KEY=
# OPENROUTER_API_KEY=
# COHERE_API_KEY=
# DASHSCOPE_API_KEY=
# AZURE_OPENAI_API_KEY=
